<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CleaningUpdaterHost</AssemblyName>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UpdateSecurity/UpdateSecurity.csproj" />
    <EmbeddedResource Include="TrustedUpdateKey.pem" Condition="Exists('TrustedUpdateKey.pem')" />
  </ItemGroup>
  <Target Name="RequireTrustedKeyForRelease" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release' and !Exists('TrustedUpdateKey.pem')">
    <Error Text="The release updater requires updater/NativeHost/TrustedUpdateKey.pem. Never publish an updater without a trusted signing key." />
  </Target>
</Project>
